{
  "name": "dolphinreef-ui",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:logical-css": "node scripts/check-logical-css.mjs",
    "test:fixtures": "node scripts/make-test-locale.mjs",
    "test:e2e": "playwright test",
    "audit:crawl": "node scripts/audit/crawl.mjs",
    "qa:build": "PRICE_RENDERING=dynamic next build && node scripts/make-test-locale.mjs && PRICE_RENDERING=dynamic I18N_TEST_LOCALES=en NEXT_DIST_DIR=.next-ltr next build",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
    "qa:visual": "node scripts/qa/visual.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.56.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}