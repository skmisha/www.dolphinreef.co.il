      "heading": "כל מה שרציתם ולא העזתם לחלום",
      "level": 1,
      "paragraphs": [],
      "links": [],
      "images": [
        {
          "src": "https://static.wixstatic.com/media/166e60_0eb8b031caed4e24a4bebafcde5cb97d~mv2.png/v1/fill/w_70,h_60,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/DOLPHIN%20REEF%20LOGO_HQ.png",
