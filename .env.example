# All variables are optional. Defaults are safe for preview deployments.

# Public base URL (canonical, hreflang, sitemap). Set to the Vercel URL on previews.
NEXT_PUBLIC_SITE_URL=https://www.dolphinreef.co.il

# Search-engine indexing. Keep false everywhere except the real production domain at launch.
ALLOW_INDEXING=false

# Price data source: json (reads /data/prices.json). A future API adds a new value.
DATA_SOURCE=json
# Simulated latency of the JSON price repository (ms) so loading states exist now.
PRICE_LATENCY_MIN_MS=150
PRICE_LATENCY_MAX_MS=400
# QA only: force price states ("error" | "empty"). Leave empty in production.
PRICE_SIMULATE=

# Media (videos) base URL once moved to a CDN / Vercel Blob. Empty = served from /public/assets.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Booking links: "_self" (default, same tab) or "_blank".
NEXT_PUBLIC_BOOKING_TARGET=_self
# Optional query string appended to every booking link, e.g. utm_source=website&utm_medium=cta
NEXT_PUBLIC_BOOKING_UTM=

# Analytics (loaded only after cookie consent). None found on the live site.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Tests only: enable the dummy LTR locale (content from tests/fixtures/content/en).
I18N_TEST_LOCALES=
